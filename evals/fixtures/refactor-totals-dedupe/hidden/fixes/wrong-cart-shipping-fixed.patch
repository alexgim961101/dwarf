diff -ruN a/src/pricing/totals.js w1/src/pricing/totals.js
--- a/src/pricing/totals.js
+++ w1/src/pricing/totals.js
@@ -0,0 +1,64 @@
+import { isRemote } from '../shipping/zones.js';
+
+const VAT_PERCENT = 10;
+export const FREE_SHIPPING_FROM = 50000;
+const SHIPPING_FEE = 3000;
+const REMOTE_SURCHARGE = 3000;
+
+function couponDiscount(coupon, subtotal) {
+  if (!coupon) return 0;
+  if (coupon.minSubtotal && subtotal < coupon.minSubtotal) return 0;
+  if (coupon.kind === 'amount') return Math.min(coupon.value, subtotal);
+  const discount = Math.floor((subtotal * coupon.value) / 100);
+  return coupon.maxDiscount ? Math.min(discount, coupon.maxDiscount) : discount;
+}
+
+// 음수(반품 줄)는 절댓값으로 반올림해 원래 줄과 부호만 다르게 한다. 양수에서는 Math.round와 같다.
+const roundHalfAway = (value) => Math.sign(value) * Math.round(Math.abs(value));
+const vatOf = (amount) => roundHalfAway((amount * VAT_PERCENT) / 100);
+const amountOf = (line) => line.unitPrice * line.qty;
+const sumOf = (lines, pick) => lines.reduce((sum, line) => sum + pick(line), 0);
+
+// 줄별 금액. 쿠폰 할인을 줄 금액 비율로 나누고 남는 원은 마지막 줄에 싣는다.
+export function lineBreakdown(lines, discount) {
+  const subtotal = sumOf(lines, amountOf);
+  let rest = discount;
+  return lines.map((line, index) => {
+    const amount = amountOf(line);
+    const isLast = index === lines.length - 1;
+    const share = isLast ? rest : discount === 0 ? 0 : Math.floor((discount * amount) / subtotal);
+    rest -= share;
+    return { ...line, amount, discount: share, tax: line.taxClass === 'standard' ? vatOf(amount - share) : 0 };
+  });
+}
+
+const TAX = {
+  // 과세 금액 합계에서 한 번 반올림한다.
+  total(lines, discount, subtotal) {
+    const taxable = sumOf(lines.filter((line) => line.taxClass === 'standard'), amountOf);
+    const taxableDiscount = subtotal === 0 ? 0 : Math.floor((discount * taxable) / subtotal);
+    return Math.round(((taxable - taxableDiscount) * VAT_PERCENT) / 100);
+  },
+  // 줄마다 반올림한 세액을 더한다.
+  line: (lines, discount) => sumOf(lineBreakdown(lines, discount), (line) => line.tax),
+};
+
+// 금액 계산. 경로마다 다른 규칙은 policy로 받는다.
+//   freeShippingBasis: 'list'(쿠폰 전 금액) | 'discounted'(쿠폰 뒤 금액)
+//   taxRounding: 'total' | 'line'
+//   chargesShipping(lines, subtotal): 배송비를 매길지
+export function computeTotals(lines, { coupon = null, region } = {}, policy) {
+  const subtotal = sumOf(lines, amountOf);
+  const discount = couponDiscount(coupon, subtotal);
+  const discounted = subtotal - discount;
+
+  let shipping = 0;
+  if (policy.chargesShipping(lines, subtotal)) {
+    const basis = policy.freeShippingBasis === 'list' ? subtotal : discounted;
+    shipping = basis >= FREE_SHIPPING_FROM ? 0 : SHIPPING_FEE;
+    if (isRemote(region)) shipping += REMOTE_SURCHARGE;
+  }
+
+  const tax = TAX[policy.taxRounding](lines, discount, subtotal);
+  return { subtotal, discount, shipping, tax, total: discounted + shipping + tax };
+}
